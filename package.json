{
  "name": "keyring",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --build && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --build --force",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "wdio run e2e/wdio.conf.ts",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:freeze": "node scripts/check-freeze.mjs",
    "check:crypto-generation": "node scripts/check-crypto-generation.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "icons:placeholder": "node scripts/make-placeholder-icon.mjs",
    "verify:v1": "node scripts/verify-v1.mjs"
  },
  "pnpm": {
    "//": "Postinstall scripts are denied by default. esbuild is allow-listed because Vite needs its platform binary; the WebDriver downloaders are not, since we drive Tauri, not browsers.",
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "22.19.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "@wdio/cli": "9.30.1",
    "@wdio/tauri-service": "1.3.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "happy-dom": "20.11.2",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "webdriverio": "9.30.1"
  }
}
