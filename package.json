{
  "name": "trynta",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first, end-to-end encrypted password manager for the desktop.",
  "homepage": "https://www.trynta.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmedjidar/trynta.git"
  },
  "bugs": {
    "url": "https://github.com/ahmedjidar/trynta/issues",
    "email": "contact@trynta.dev"
  },
  "author": "Ahmed Amin <contact@trynta.dev>",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --build && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --build --force",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "wdio run e2e/wdio.conf.ts",
    "e2e:setup": "node scripts/check-e2e-ready.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:unsafe": "node scripts/check-unsafe.mjs",
    "check:network": "node scripts/check-network.mjs",
    "check:freeze": "node scripts/check-freeze.mjs",
    "check:crypto-generation": "node scripts/check-crypto-generation.mjs",
    "check:ts-rs": "node scripts/check-ts-rs.mjs",
    "check:wordlist": "node scripts/check-wordlist.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "icons:placeholder": "node scripts/make-placeholder-icon.mjs",
    "verify:v1": "node scripts/verify-v1.mjs",
    "icons:build": "tsx scripts/build-icon-map.ts",
    "icons:report": "tsx scripts/build-icon-map.ts --report",
    "icons:brand": "node scripts/build-brand-icons.mjs",
    "check:brand-icons": "node scripts/check-brand-icons.mjs",
    "build:site": "node scripts/build-site.mjs",
    "check:site-tokens": "node scripts/check-site-tokens.mjs"
  },
  "pnpm": {
    "//": "Postinstall scripts are denied by default. esbuild is allow-listed because Vite needs its platform binary; the WebDriver downloaders are not, since we drive Tauri, not browsers.",
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "auditConfig": {
      "//": "Same discipline as .cargo/audit.toml: every entry names why it cannot reach a shipped binary, no entry is ever a production dependency, and the list is re-reviewed on every bump. GHSA-jmr9-qjv8-65gv is extract-zip symlink path traversal, reached only via @wdio/cli > @wdio/utils > @puppeteer/browsers -- the E2E harness's browser downloader. It is a devDependency, it never enters the app bundle, and we drive a Tauri binary rather than a browser so the downloader never runs at all. Upstream publishes no patched version. Delete this the moment @wdio/cli stops pulling it. Deliberately NOT --ignore-unfixable, which would also silence a future unfixable advisory in a production dependency.",
      "ignoreGhsas": [
        "GHSA-jmr9-qjv8-65gv"
      ]
    }
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "^1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "22.19.0",
    "@types/psl": "^1.11.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "@wdio/cli": "9.30.1",
    "@wdio/local-runner": "9.30.1",
    "@wdio/mocha-framework": "9.30.1",
    "@wdio/spec-reporter": "9.30.1",
    "@wdio/tauri-service": "1.3.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "happy-dom": "20.11.2",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "psl": "1.15.0",
    "svgo": "3.3.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "webdriverio": "9.30.1"
  }
}
